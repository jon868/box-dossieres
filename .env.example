# --- Box (app "claudebox", las mismas credenciales que el conector y box-etiquetar)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_TYPE=enterprise
BOX_SUBJECT_ID=

# --- Anthropic (crea una API key propia, p. ej. "dossieres", con límite de gasto)
ANTHROPIC_API_KEY=
MODELO=claude-haiku-5-5

# --- Telegram
# Token que da @BotFather y tu ID numérico de Telegram (varios separados por comas)
TELEGRAM_TOKEN=
ADMIN_IDS=

# --- Asistente del bot (Claude interpreta la pregunta y elige los dossieres)
# USAR_CLAUDE=true                     # false: solo búsqueda por palabras
# BOT_MODELO=claude-haiku-5-5
# BOT_MAX_BUSQUEDAS=4                  # búsquedas por pregunta
# BOT_MINUTOS_MEMORIA=60               # cuánto recuerda la conversación

# --- Registro de uso
# REGISTRO_DIAS=365                    # se borra lo más antiguo
# MIN_REPREGUNTA=5                     # minutos para contar una repregunta
# MIN_REINICIO=10

# --- Indexado (valores por defecto: no hace falta tocarlos)
# CARPETAS=6906273278,236966097161     # Dossieres PDF 2016-2023 y Desde 2024
# EXCLUIR_IDS=164858983963             # RECOPILATORIOS
# EXCLUIR_PATRON=presupuesto|ppto
# EXTENSIONES=pdf,pptx
# EXCEL_ID=302492593457                # Listado de Dossieres y Renders (links).xlsx
# AUTO_INDEXAR=false                   # true: el bot relanza el indexado cada noche
# INDEXAR_HORA=3
