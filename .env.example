# --- Box (app "claudebox", las mismas credenciales que el conector y box-etiquetar)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_TYPE=enterprise
BOX_SUBJECT_ID=

# --- Anthropic (crea una API key propia, p. ej. "dossieres", con límite de gasto)
ANTHROPIC_API_KEY=
MODELO=claude-haiku-5-5

# --- Telegram
# Token que da @BotFather y tu ID numérico de Telegram (varios separados por comas)
TELEGRAM_TOKEN=
ADMIN_IDS=

